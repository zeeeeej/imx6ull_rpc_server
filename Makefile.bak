TARGET=rpc_server
CC=arm-buildroot-linux-gnueabihf-gcc

LIBEV_DIR=/home/book/Desktop/jsonrpc2/libev_pc/tmp
JSONRPC_DIR=/home/book/Desktop/jsonrpc2/jsonrpc-c_pc/tmp

CFLAGS=-I${LIBEV_DIR}/include -I${JSONRPC_DIR}/include -I/home/book/proj/hdinit/
LDFLAGS=-L${LIBEV_DIR}/lib/libev.a -L/home/book/proj/hdinit/.shared/build/ -L${JSONRPC_DIR}/lib/libjsonrpcc.a   -lm -lpthread -lhsi

c_files = cJSON.c rpc_server.c led.c dht11.c

all:
	${CC} ${CFLAGS} -o ${TARGET} ${c_files} ${LDFLAGS}

clean:
	rm -f *.o ${TARGET}
	
